---
// src/pages/projects/Omatsu-RebootCAMP/news/index.astro
import OmatsuLayout from '../../../../layouts/OmatsuLayout.astro';
import { BASE, news, formatDate } from '../../../../lib/omatsu';

const sorted = [...news].sort((a, b) => (a.date < b.date ? 1 : -1));
---

<OmatsuLayout
  title="お知らせ"
  description="OMATSU-Reboot CAMPからのお知らせ・募集情報の一覧です。"
  current="news"
  breadcrumbs={[
    { name: 'ホーム', url: '/' },
    { name: '協働とプロジェクト', url: '/projects' },
    { name: 'OMATSU-Reboot CAMP', url: BASE },
    { name: 'お知らせ', url: '/projects/Omatsu-RebootCAMP/news' },
  ]}
>
  <div class="om-page-head">
    <div class="om-container">
      <h1 class="om-sec-head">
        <span class="en">NEWS</span>
        <span class="ja">お知らせ</span>
        <span class="rule"></span>
      </h1>
    </div>
  </div>

  <div class="om-container">
    <nav class="om-breadcrumb">
      <a href="/">ホーム</a>
      <span>・</span>
      <a href="/projects">協働とプロジェクト</a>
      <span>・</span>
      <a href={BASE}>OMATSU-RebootCAMP</a>
      <span>・</span>
      <span>お知らせ</span>
    </nav>
  </div>

  <section class="news-section">
    <div class="om-container">
      {
        sorted.length > 0 ? (
          <ul class="news-list om-appear">
            {sorted.map((item) => (
              <li>
                <a href={`${BASE}/news/${item.slug}`}>
                  <time datetime={item.date}>{formatDate(item.date)}</time>
                  {item.category && <span class="category">{item.category}</span>}
                  <span class="title">{item.title}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="empty om-appear">
            <p class="empty-title">お知らせは準備中です</p>
            <p class="empty-text">
              募集開始や参加者募集の情報は、こちらでお知らせします。
            </p>
            <a href={BASE} class="om-arrow-link">
              <span class="circle material-icons-outlined">trending_flat</span>
              <span class="label">トップへもどる</span>
            </a>
          </div>
        )
      }
    </div>
  </section>
</OmatsuLayout>

<style>
  .news-section {
    padding: 32px 0 120px;
  }

  .news-list {
    max-width: 880px;
    margin: 0 auto;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }

  .news-list a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 20px;
    padding: 24px 4px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    transition: color 0.2s ease;
  }

  .news-list a:hover {
    color: var(--om-blue);
  }

  .news-list time {
    font-family: var(--om-font-en);
    font-size: 14px;
    color: var(--om-gray);
    letter-spacing: 0.08em;
    flex: none;
  }

  .category {
    flex: none;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--om-blue);
    border: 1px solid var(--om-blue);
    padding: 2px 10px;
  }

  .title {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.7;
    flex: 1 1 320px;
    min-width: 0;
  }

  .empty {
    background: var(--om-bg);
    padding: 72px 24px;
    text-align: center;
  }

  .empty-title {
    font-size: 22px;
    font-weight: 700;
    color: var(--om-black);
  }

  .empty-text {
    font-size: 15px;
    line-height: 2;
    margin: 16px 0 32px;
  }

  .empty .om-arrow-link {
    justify-content: center;
  }

  @media (max-width: 900px) {
    .news-section {
      padding: 24px 0 72px;
    }

    .news-list a {
      padding: 20px 4px;
    }

    .title {
      font-size: 16px;
      flex-basis: 100%;
    }

    .empty {
      padding: 48px 20px;
    }
  }
</style>
