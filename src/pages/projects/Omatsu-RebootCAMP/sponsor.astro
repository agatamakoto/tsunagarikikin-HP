---
// src/pages/projects/Omatsu-RebootCAMP/sponsor.astro
// 協賛企業ページ。①趣旨説明 ②ロゴ掲載（ゴールド→シルバー→ブロンズ）③インタビュー記事の一覧
//
// 【編集の仕方】
//   ロゴの追加・並び順      … src/lib/omatsu.ts の sponsors 配列
//   インタビューのカード    … src/lib/omatsu.ts の interviews 配列
//   インタビューの本文      … src/pages/projects/Omatsu-RebootCAMP/interview/<slug>.astro
import OmatsuLayout from '../../../layouts/OmatsuLayout.astro';
import {
  BASE,
  findInterview,
  interviews,
  sponsorTierLabels,
  sponsorsByTier,
} from '../../../lib/omatsu';

const tiers = (['gold', 'silver', 'bronze'] as const).map((tier) => ({
  tier,
  ...sponsorTierLabels[tier],
  list: sponsorsByTier(tier),
}));
---

<OmatsuLayout
  title="協賛企業"
  description="OMATSU-Reboot CAMPは、地域のお祭りの未来を共につくる協賛企業の皆さまに支えられています。ゴールド・シルバー・ブロンズ各スポンサーのご紹介と、協賛企業インタビューを掲載しています。"
  current="sponsor"
>
  <div class="om-page-head">
    <div class="om-container">
      <h1 class="om-sec-head">
        <span class="en">SPONSOR</span>
        <span class="ja">協賛企業</span>
        <span class="rule"></span>
      </h1>
    </div>
  </div>

  <div class="om-container">
    <nav class="om-breadcrumb">
      <a href="/">ホーム</a>
      <span>・</span>
      <a href="/projects">協働とプロジェクト</a>
      <span>・</span>
      <a href={BASE}>OMATSU-RebootCAMP</a>
      <span>・</span>
      <span>協賛企業</span>
    </nav>
  </div>

  <!-- ===== ① 趣旨説明 ===== -->
  <section class="purpose">
    <div class="om-container">
      <p class="purpose-lead om-appear">
        お祭りを未来へ繋ぐ挑戦は、<br />
        地域を支える企業の皆さまと共にあります。
      </p>

      <div class="purpose-body om-appear">
        <p>
          愛媛県内の多くのお祭りが、担い手不足という共通の課題に直面しています。祭りは単なる年中行事ではなく、世代を超えて人が集い、地域の絆が結び直される場です。その場が失われることは、地域そのものの力が失われることを意味します。
        </p>
        <p>
          OMATSU-Reboot
          CAMPは、お祭りの継続に向けて担い手を増やしたい自治会・お祭り運営組織と、お祭りに関わってみたい地域内外の人材をつなぐプログラムです。参加者には、祭りの担い手として共に汗を流すことを通じて、地域文化の体験と、会いに行きたいと思える人とのつながりを持ち帰っていただいています。
        </p>
        <p>
          この取り組みは、地域の未来に投資してくださる協賛企業の皆さまのご支援によって成り立っています。いただいた協賛金は、参加者の受け入れ体制の整備、地域とのマッチング運営、活動の記録・発信に活用させていただきます。
        </p>
        <p class="purpose-note">
          協賛にご関心をお持ちの企業・団体の皆さまは、事務局までお気軽にお問い合わせください。
        </p>
      </div>

      <div class="purpose-cta om-appear">
        <a href={`${BASE}/entry`} class="om-arrow-link">
          <span class="circle material-icons-outlined">trending_flat</span>
          <span class="label">協賛について問い合わせる</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== ② ロゴ掲載 ===== -->
  <section class="sponsors">
    <div class="om-container">
      <div class="om-sec-head om-appear">
        <span class="en">SPONSORS</span>
        <span class="ja">協賛企業一覧</span>
        <span class="rule"></span>
      </div>

      {
        tiers.map((t) => (
          <div class={`tier is-${t.tier} om-appear`}>
            <div class="tier-head">
              <span class="tier-en">{t.en}</span>
              <h2 class="tier-ja">{t.ja}</h2>
            </div>

            {t.list.length > 0 ? (
              <ul class={`logo-list is-${t.tier}`}>
                {t.list.map((s) => (
                  <li class="logo-item">
                    {s.url ? (
                      <a href={s.url} target="_blank" rel="noreferrer" class="logo-frame">
                        {s.logo ? (
                          <img src={s.logo} alt={`${s.name} ロゴ`} />
                        ) : (
                          <div class="om-ph">
                            <span>
                              ロゴ
                              <span class="note">{s.name}</span>
                            </span>
                          </div>
                        )}
                      </a>
                    ) : (
                      <div class="logo-frame">
                        {s.logo ? (
                          <img src={s.logo} alt={`${s.name} ロゴ`} />
                        ) : (
                          <div class="om-ph">
                            <span>
                              ロゴ
                              <span class="note">{s.name}</span>
                            </span>
                          </div>
                        )}
                      </div>
                    )}
                    <p class="logo-name">{s.name}</p>
                    {s.url && (
                      <a href={s.url} target="_blank" rel="noreferrer" class="logo-site">
                        公式サイト
                        <span class="material-icons-outlined">open_in_new</span>
                      </a>
                    )}
                    {s.interviewSlug && findInterview(s.interviewSlug) && (
                      <a href={`${BASE}/interview/${s.interviewSlug}`} class="logo-interview">
                        インタビューを読む →
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="tier-empty">現在、募集中です。</p>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <!-- ===== ③ インタビュー記事 =====
       src/lib/omatsu.ts の interviews が空のあいだは、この欄ごと表示されません。
       記事を1件でも登録すると自動的に現れます。 -->
  {
    interviews.length > 0 && (
      <section class="interviews">
        <div class="om-container">
          <div class="om-sec-head om-appear">
            <span class="en">INTERVIEW</span>
            <span class="ja">協賛企業インタビュー</span>
            <span class="rule" />
          </div>

          <p class="interview-intro om-appear">
            協賛いただいている企業さまに、地域のお祭りへの想いを伺いました。
          </p>

          <ul class="interview-grid om-appear">
            {interviews.map((iv) => (
              <li>
                <a href={`${BASE}/interview/${iv.slug}`} class="iv-card">
                  <div class="iv-thumb">
                    {iv.thumbnail ? (
                      <img src={iv.thumbnail} alt={`${iv.company} インタビュー`} />
                    ) : (
                      <div class="om-ph">
                        <span>
                          写真
                          <span class="note">{iv.company} インタビュー</span>
                        </span>
                      </div>
                    )}
                    <span class={`iv-badge is-${iv.tier}`}>
                      {sponsorTierLabels[iv.tier].en}
                    </span>
                  </div>
                  <div class="iv-body">
                    <h3>{iv.title}</h3>
                    {iv.summary && <p class="iv-summary">{iv.summary}</p>}
                    <span class="iv-more">記事を読む →</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- ===== 協賛のお願い ===== -->
  <section class="cta-block">
    <div class="om-container cta-inner om-appear">
      <p class="cta-title">協賛企業を募集しています</p>
      <p class="cta-text">
        100年先も祭りが続く地域を、一緒につくっていただける企業・団体さまを募集しています。<br />
        協賛の内容・特典については、事務局よりご説明いたします。
      </p>
      <a href={`${BASE}/entry`} class="om-entry-btn is-lg">
        <span>事務局に問い合わせる</span>
        <span class="material-icons-outlined">mail_outline</span>
      </a>
    </div>
  </section>
</OmatsuLayout>

<style>
  /* ===== ① 趣旨説明 ===== */
  .purpose {
    padding: 64px 0 96px;
  }

  .purpose-lead {
    font-size: 32px;
    font-weight: 700;
    line-height: 1.8;
    letter-spacing: 0.05em;
    color: var(--om-black);
    text-align: center;
  }

  .purpose-body {
    max-width: 820px;
    margin: 48px auto 0;
    font-size: 16px;
    line-height: 2.1;
  }

  .purpose-body p {
    margin-bottom: 28px;
  }

  .purpose-note {
    padding: 20px 24px;
    background: var(--om-bg);
    border-left: 5px solid var(--om-blue);
    font-size: 15px;
    line-height: 1.9;
    margin-bottom: 0;
  }

  .purpose-cta {
    margin-top: 40px;
    display: flex;
    justify-content: center;
  }

  /* ===== ② ロゴ掲載 ===== */
  .sponsors {
    background: var(--om-bg);
    padding: 110px 0;
  }

  .tier {
    margin-top: 72px;
  }

  .tier-head {
    text-align: center;
    margin-bottom: 40px;
  }

  .tier-en {
    display: inline-block;
    font-family: var(--om-font-en);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--om-white);
    padding: 5px 20px;
  }

  .is-gold .tier-en {
    background: #c8a03c;
  }

  .is-silver .tier-en {
    background: #8c9199;
  }

  .is-bronze .tier-en {
    background: #a4703f;
  }

  .tier-ja {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--om-black);
    margin-top: 12px;
  }

  .logo-list {
    display: grid;
    gap: 32px;
    justify-content: center;
  }

  /* 階級が上ほどロゴを大きく見せる。
     ロゴの縦横比は各社バラバラなので、枠の大きさを揃えて
     その中に収める（object-fit: contain）ことで見た目を揃える。 */
  .logo-list.is-gold {
    grid-template-columns: repeat(auto-fit, minmax(0, 460px));
  }

  .logo-list.is-silver {
    grid-template-columns: repeat(auto-fit, minmax(0, 380px));
  }

  .logo-list.is-bronze {
    grid-template-columns: repeat(auto-fit, minmax(0, 300px));
  }

  .logo-item {
    text-align: center;
  }

  .logo-frame {
    display: block;
    background: var(--om-white);
    padding: 24px 28px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  a.logo-frame:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.08);
  }

  .logo-frame img {
    width: 100%;
    height: 100px;
    object-fit: contain;
  }

  .is-gold .logo-frame img {
    height: 160px;
  }

  .is-silver .logo-frame img {
    height: 130px;
  }

  .logo-frame .om-ph {
    height: 100px;
  }

  .logo-name {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--om-black);
    margin-top: 16px;
  }

  .logo-site {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    color: var(--om-gray);
    margin-top: 6px;
  }

  .logo-site .material-icons-outlined {
    font-size: 14px;
  }

  .logo-site:hover {
    color: var(--om-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .logo-interview {
    display: inline-block;
    font-size: 14px;
    font-weight: 700;
    color: var(--om-blue);
    margin-top: 8px;
  }

  .logo-interview:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .tier-empty {
    text-align: center;
    font-size: 15px;
    color: var(--om-gray);
  }

  /* ===== ③ インタビュー（カード一覧） ===== */
  .interviews {
    padding: 110px 0;
  }

  .interview-intro {
    text-align: center;
    font-size: 16px;
    line-height: 2;
    margin-top: 40px;
  }

  .interview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    gap: 40px;
    margin-top: 48px;
  }

  /* 2件以上なら2列に */
  .interview-grid:has(li:nth-child(2)) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .iv-card {
    display: block;
    height: 100%;
    background: var(--om-white);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .iv-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
  }

  .iv-thumb {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--om-bg);
    overflow: hidden;
  }

  .iv-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .iv-thumb .om-ph {
    height: 100%;
    border: none;
  }

  .iv-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    font-family: var(--om-font-en);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--om-white);
    padding: 6px 16px;
    border-radius: 999px;
  }

  .iv-badge.is-gold {
    background: #c8a03c;
  }

  .iv-badge.is-silver {
    background: #8c9199;
  }

  .iv-badge.is-bronze {
    background: #a4703f;
  }

  .iv-body {
    padding: 28px 28px 32px;
  }

  .iv-body h3 {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: var(--om-black);
  }

  .iv-summary {
    font-size: 15px;
    line-height: 1.9;
    color: var(--om-text);
    margin-top: 14px;
  }

  .iv-more {
    display: inline-block;
    font-size: 14px;
    font-weight: 700;
    color: var(--om-blue);
    margin-top: 18px;
  }

  .interview-empty {
    text-align: center;
    font-size: 15px;
    color: var(--om-gray);
    margin-top: 48px;
  }

  /* ===== 協賛のお願い ===== */
  .cta-block {
    background: var(--om-bg);
    padding: 96px 0;
  }

  .cta-inner {
    text-align: center;
  }

  .cta-title {
    font-size: 26px;
    font-weight: 700;
    color: var(--om-black);
  }

  .cta-text {
    font-size: 16px;
    line-height: 2;
    margin: 20px 0 32px;
  }

  .om-entry-btn.is-lg {
    height: 64px;
    min-width: 300px;
    font-size: 17px;
  }

  /* ===== レスポンシブ ===== */
  @media (max-width: 900px) {
    .purpose {
      padding: 40px 0 64px;
    }

    .purpose-lead {
      font-size: 21px;
      text-align: left;
    }

    .purpose-body {
      margin-top: 32px;
    }

    .sponsors,
    .interviews,
    .cta-block {
      padding: 64px 0;
    }

    .tier {
      margin-top: 48px;
    }

    .logo-list.is-gold,
    .logo-list.is-silver,
    .logo-list.is-bronze {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .interview-intro {
      text-align: left;
      margin-top: 32px;
    }

    .interview-grid,
    .interview-grid:has(li:nth-child(2)) {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      margin-top: 32px;
    }

    .iv-body {
      padding: 22px 22px 26px;
    }

    .iv-body h3 {
      font-size: 20px;
    }

    .cta-title {
      font-size: 21px;
    }

    .om-entry-btn.is-lg {
      min-width: 0;
      width: 100%;
    }
  }
</style>
