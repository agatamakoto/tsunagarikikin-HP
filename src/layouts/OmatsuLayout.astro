---
// src/layouts/OmatsuLayout.astro
// OMATSU-RebootCAMP 専用レイアウト（STUDIO版のデザインを再現）
// 基金サイト本体（Layout.astro）とは別系統。グローバルCSSを共有しない。
import {
  BASE,
  CONTACT_EMAIL,
  HERO_IMAGES,
  LOGO,
  SITE_DESCRIPTION,
} from '../lib/omatsu';

interface Props {
  title: string;
  description?: string;
  current?: 'top' | 'about' | 'project' | 'sponsor' | 'news' | 'entry';
  /** SNSシェア用の画像（省略時はメインビジュアル） */
  ogImage?: string;
  /** 記事ページなら 'article'。省略時は 'website' */
  ogType?: 'website' | 'article';
  /** パンくずの構造化データ用。[{name, url}] を上位から順に */
  breadcrumbs?: { name: string; url: string }[];
  /** 検索結果に出したくないページは true */
  noindex?: boolean;
}

const {
  title,
  description,
  current,
  ogImage,
  ogType = 'website',
  breadcrumbs,
  noindex = false,
} = Astro.props;

const nav = [
  { en: 'ABOUT', ja: 'プログラムについて', href: `${BASE}/about`, key: 'about' },
  { en: 'PROJECT', ja: 'プロジェクトについて', href: `${BASE}/project`, key: 'project' },
  { en: 'SPONSOR', ja: '協賛企業', href: `${BASE}/sponsor`, key: 'sponsor' },
  { en: 'NEWS', ja: 'お知らせ', href: `${BASE}/news`, key: 'news' },
];

// ===== 検索エンジン・生成AI向けの情報 =====
const site = Astro.site ?? new URL('https://escf.jp');
const canonical = new URL(Astro.url.pathname, site).href.replace(/\/$/, '') || site.href;
const metaDescription = description || SITE_DESCRIPTION;
const pageTitle = `${title} | OMATSU-Reboot CAMP`;
const ogImageUrl = new URL(ogImage || HERO_IMAGES[0], site).href;

// プログラム本体の説明。生成AIや検索エンジンが「何の取り組みか」を
// 正確に読み取れるよう、主催者・対象・地域・費用まで明示する。
const programSchema = {
  '@context': 'https://schema.org',
  '@type': 'VolunteerOpportunity',
  name: 'OMATSU-Reboot CAMP',
  alternateName: 'OMATSU-RebootCAMP／オマツリブートキャンプ',
  description: SITE_DESCRIPTION,
  url: new URL(BASE, site).href,
  inLanguage: 'ja',
  provider: {
    '@type': 'NGO',
    name: '公益財団法人えひめ西条つながり基金',
    url: site.href,
    email: CONTACT_EMAIL,
    address: {
      '@type': 'PostalAddress',
      postalCode: '793-0030',
      addressCountry: 'JP',
      addressRegion: '愛媛県',
      addressLocality: '西条市',
      streetAddress: '大町1663番地',
    },
  },
  areaServed: { '@type': 'AdministrativeArea', name: '愛媛県' },
  audience: {
    '@type': 'Audience',
    audienceType: '20歳以上で地域のお祭りや伝統文化に関心のある方',
    suggestedMinAge: 20,
  },
  isAccessibleForFree: true,
  keywords:
    '西条祭り, 飯積神社祭礼, 伊曽乃神社祭礼, 太鼓台, だんじり, 屋台, 祭りの担い手, 愛媛県, 地域おこし, 関係人口',
};

const breadcrumbSchema = breadcrumbs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: new URL(b.url, site).href,
      })),
    }
  : null;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {
      !noindex && (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1"
        />
      )
    }

    <!-- SNSでシェアされたときの見え方 -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="OMATSU-Reboot CAMP" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- 検索エンジン・生成AI向けの構造化データ -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(programSchema)}
    />
    {
      breadcrumbSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(breadcrumbSchema)}
        />
      )
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Noto+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined"
      rel="stylesheet"
    />

    <style is:global>
      /* ===== リセット ===== */
      *,
      *::before,
      *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      /* ===== デザイントークン（STUDIO版から抽出） ===== */
      :root {
        --om-blue: #1f96cd;
        --om-black: #060606;
        --om-text: #333333;
        --om-gray: #888888;
        --om-bg: #f6f6f6;
        --om-white: #ffffff;

        --om-font: 'Noto Sans JP', -apple-system, BlinkMacSystemFont, 'Segoe UI',
          sans-serif;
        --om-font-en: 'Lato', 'Noto Sans JP', sans-serif;

        --om-header-h: 108px;
        --om-container: 1105px;
      }

      html {
        font-family: var(--om-font);
        font-size: 16px;
        color: var(--om-text);
        scroll-behavior: smooth;
      }

      body {
        background: var(--om-white);
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }

      img {
        max-width: 100%;
        height: auto;
        display: block;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      ul,
      ol {
        list-style: none;
      }

      .material-icons-outlined {
        font-family: 'Material Icons Outlined';
        font-weight: normal;
        font-style: normal;
        line-height: 1;
        letter-spacing: normal;
        text-transform: none;
        display: inline-block;
        white-space: nowrap;
        word-wrap: normal;
        direction: ltr;
        -webkit-font-feature-settings: 'liga';
        -webkit-font-smoothing: antialiased;
      }

      /* ===== 共通レイアウト ===== */
      .om-container {
        width: 100%;
        max-width: var(--om-container);
        margin: 0 auto;
        padding: 0 24px;
      }

      /* ===== セクション見出し（EN大 + JA小 + 罫線） ===== */
      .om-sec-head {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .om-sec-head.is-left {
        align-items: flex-start;
        text-align: left;
      }

      .om-sec-head .en {
        font-family: var(--om-font-en);
        font-size: 46px;
        font-weight: 700;
        line-height: 1.4;
        letter-spacing: 0.05em;
        color: var(--om-blue);
      }

      .om-sec-head .ja {
        font-size: 16px;
        font-weight: 500;
        line-height: 1.4;
        letter-spacing: 0.2em;
        color: var(--om-text);
        margin-top: 8px;
      }

      .om-sec-head .rule {
        width: 30px;
        height: 2px;
        background: var(--om-blue);
        margin-top: 20px;
      }

      /* ===== 丸矢印リンク ===== */
      .om-arrow-link {
        display: inline-flex;
        align-items: center;
        gap: 16px;
      }

      .om-arrow-link .circle {
        flex: none;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: var(--om-blue);
        color: var(--om-white);
        display: grid;
        place-items: center;
        font-size: 24px;
        transition: transform 0.25s ease, opacity 0.25s ease;
      }

      .om-arrow-link .label {
        font-size: 16px;
        font-weight: 700;
        letter-spacing: 0.05em;
        color: var(--om-black);
      }

      .om-arrow-link:hover .circle {
        transform: translateX(4px);
        opacity: 0.85;
      }

      .om-arrow-link.is-sm .circle {
        width: 30px;
        height: 30px;
        font-size: 16px;
      }

      .om-arrow-link.is-sm .label {
        font-size: 14px;
      }

      /* ===== 写真プレースホルダー（差し替え前の仮枠） ===== */
      .om-ph {
        width: 100%;
        background: repeating-linear-gradient(
          45deg,
          rgba(31, 150, 205, 0.06),
          rgba(31, 150, 205, 0.06) 10px,
          rgba(31, 150, 205, 0.12) 10px,
          rgba(31, 150, 205, 0.12) 20px
        );
        border: 2px dashed rgba(31, 150, 205, 0.45);
        display: grid;
        place-items: center;
        text-align: center;
        color: var(--om-blue);
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 0.08em;
        padding: 16px;
      }

      .om-ph span {
        display: block;
        opacity: 0.85;
      }

      .om-ph .note {
        font-size: 11px;
        font-weight: 400;
        letter-spacing: 0.04em;
        margin-top: 6px;
        opacity: 0.7;
      }

      /* ===== ヘッダー ===== */
      .om-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: var(--om-white);
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
      }

      .om-header-inner {
        height: var(--om-header-h);
        max-width: 1265px;
        margin: 0 auto;
        padding: 0 30px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .om-logo {
        flex: none;
        width: 280px;
        max-width: 45vw;
        display: block;
      }

      .om-logo img {
        width: 100%;
        height: auto;
      }

      .om-nav {
        display: flex;
        align-items: center;
        gap: 32px;
      }

      .om-nav-list {
        display: flex;
        align-items: center;
        gap: 32px;
      }

      .om-nav-list a {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        padding-bottom: 4px;
        border-bottom: 2px solid transparent;
        transition: border-color 0.2s ease, color 0.2s ease;
      }

      .om-nav-list .en {
        font-family: var(--om-font-en);
        font-size: 16px;
        font-weight: 700;
        line-height: 1.4;
        color: var(--om-text);
      }

      .om-nav-list .ja {
        font-size: 10px;
        font-weight: 500;
        line-height: 1.4;
        color: var(--om-text);
      }

      .om-nav-list a:hover,
      .om-nav-list a.is-current {
        border-bottom-color: var(--om-blue);
      }

      .om-nav-list a:hover .en,
      .om-nav-list a.is-current .en {
        color: var(--om-blue);
      }

      .om-entry-btn {
        flex: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 141px;
        height: 41px;
        padding: 0 16px;
        background: var(--om-blue);
        color: var(--om-white);
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 0.05em;
        transition: opacity 0.2s ease, transform 0.2s ease;
      }

      .om-entry-btn:hover {
        opacity: 0.85;
        transform: translateY(-2px);
      }

      .om-entry-btn .material-icons-outlined {
        font-size: 16px;
      }

      /* ハンバーガー（モバイル） */
      .om-burger {
        display: none;
        flex: none;
        width: 44px;
        height: 44px;
        background: none;
        border: none;
        color: var(--om-black);
        font-size: 28px;
        cursor: pointer;
        place-items: center;
      }

      /* ===== パンくず ===== */
      .om-breadcrumb {
        padding: 24px 0;
        font-size: 12px;
        color: var(--om-gray);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
      }

      .om-breadcrumb a:hover {
        color: var(--om-blue);
      }

      /* ===== 下層ページの見出し帯 ===== */
      .om-page-head {
        background: var(--om-bg);
        padding: 72px 0 64px;
        text-align: center;
      }

      /* ===== フッター ===== */
      .om-footer {
        background: var(--om-black);
        color: var(--om-bg);
        padding: 72px 0 32px;
      }

      .om-footer-main {
        display: flex;
        flex-wrap: wrap;
        gap: 48px;
        justify-content: space-between;
      }

      .om-footer-main > * {
        min-width: 0;
        max-width: 100%;
      }

      .om-footer-logo {
        width: 360px;
        max-width: 100%;
      }

      .om-footer .address {
        overflow-wrap: anywhere;
      }

      .om-footer-logo img {
        width: 100%;
        height: auto;
      }

      .om-footer .tagline,
      .om-footer .office {
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 0.05em;
        color: var(--om-bg);
      }

      .om-footer .tagline {
        margin-top: 24px;
      }

      .om-footer .address {
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.05em;
        color: var(--om-bg);
        margin-top: 12px;
        line-height: 2;
      }

      .om-footer .address a {
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      .om-footer-nav {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .om-footer-nav a {
        font-size: 14px;
        letter-spacing: 0.15em;
        color: var(--om-white);
        transition: opacity 0.2s ease;
      }

      .om-footer-nav a:hover {
        opacity: 0.6;
      }

      .om-footer-bottom {
        margin-top: 56px;
        padding-top: 24px;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        align-items: center;
        justify-content: space-between;
      }

      .om-footer-bottom p,
      .om-footer-bottom a {
        font-size: 12px;
        letter-spacing: 0.15em;
        color: var(--om-gray);
      }

      .om-footer-bottom .links {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
      }

      .om-footer-bottom a:hover {
        color: var(--om-white);
      }

      /* ===== スクロール時のふわっと表示 ===== */
      .om-appear {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.7s cubic-bezier(0.4, 0.4, 0, 1),
          transform 0.7s cubic-bezier(0.4, 0.4, 0, 1);
      }

      .om-appear.is-shown {
        opacity: 1;
        transform: none;
      }

      @media (prefers-reduced-motion: reduce) {
        .om-appear {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }

      /* ===== レスポンシブ ===== */
      @media (max-width: 900px) {
        :root {
          --om-header-h: 72px;
        }

        .om-header-inner {
          padding: 0 16px;
        }

        .om-burger {
          display: grid;
        }

        .om-nav {
          position: fixed;
          inset: var(--om-header-h) 0 auto 0;
          background: var(--om-white);
          flex-direction: column;
          align-items: stretch;
          gap: 0;
          padding: 8px 16px 24px;
          border-bottom: 1px solid rgba(0, 0, 0, 0.08);
          box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
          transform: translateY(-8px);
          opacity: 0;
          pointer-events: none;
          transition: opacity 0.2s ease, transform 0.2s ease;
        }

        .om-nav.is-open {
          transform: none;
          opacity: 1;
          pointer-events: auto;
        }

        .om-nav-list {
          flex-direction: column;
          align-items: stretch;
          gap: 0;
        }

        .om-nav-list a {
          flex-direction: row;
          align-items: baseline;
          justify-content: flex-start;
          gap: 12px;
          padding: 16px 4px;
          border-bottom: 1px solid rgba(0, 0, 0, 0.08);
        }

        .om-entry-btn {
          margin-top: 16px;
          width: 100%;
        }

        .om-sec-head .en {
          font-size: 34px;
        }

        .om-footer-main {
          gap: 32px;
        }
      }
    </style>
  </head>

  <body>
    <header class="om-header">
      <div class="om-header-inner">
        <a href={BASE} class="om-logo" aria-label="OMATSU-Reboot CAMP トップへ">
          <img src={LOGO.horizontal} alt="OMATSU-Reboot CAMP" width="900" height="147" />
        </a>

        <button class="om-burger" type="button" aria-label="メニューを開く" aria-expanded="false">
          <span class="material-icons-outlined">menu</span>
        </button>

        <nav class="om-nav">
          <div class="om-nav-list">
            {
              nav.map((item) => (
                <a href={item.href} class={current === item.key ? 'is-current' : ''}>
                  <span class="en">{item.en}</span>
                  <span class="ja">{item.ja}</span>
                </a>
              ))
            }
          </div>
          <a href={`${BASE}/entry`} class="om-entry-btn">
            <span>エントリー</span>
            <span class="material-icons-outlined">mail_outline</span>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="om-footer">
      <div class="om-container">
        <div class="om-footer-main">
          <div>
            <div class="om-footer-logo">
              <img
                src={LOGO.horizontalWhite}
                alt="OMATSU-Reboot CAMP"
                width="1100"
                height="179"
              />
            </div>
            <p class="tagline">～100年後も楽しめる地域をつくろう～</p>
            <p class="office">事務局：公益財団法人えひめ西条つながり基金</p>
            <p class="address">
              住所：〒793-0030　愛媛県西条市大町1663番地<br />
              問い合わせメールアドレス：<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
            </p>
          </div>

          <nav class="om-footer-nav">
            <a href={`${BASE}/about`}>プログラムについて</a>
            <a href={`${BASE}/project`}>プロジェクト一覧</a>
            <a href={`${BASE}/sponsor`}>協賛企業</a>
            <a href={`${BASE}/news`}>お知らせ</a>
            <a href={`${BASE}/entry`}>エントリー</a>
          </nav>
        </div>

        <div class="om-footer-bottom">
          <p>©OMATSU-RebootCAMP.</p>
          <div class="links">
            <a href="/">えひめ西条つながり基金トップ</a>
            <a href="/projects">協働とプロジェクト</a>
            <a href="/privacy">個人情報保護方針</a>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      // ハンバーガーメニュー
      (function () {
        var burger = document.querySelector('.om-burger');
        var nav = document.querySelector('.om-nav');
        if (!burger || !nav) return;
        burger.addEventListener('click', function () {
          var open = nav.classList.toggle('is-open');
          burger.setAttribute('aria-expanded', String(open));
          burger.querySelector('.material-icons-outlined').textContent = open
            ? 'close'
            : 'menu';
        });
      })();

      // スクロール時のふわっと表示（STUDIOの appear 相当）
      (function () {
        var targets = document.querySelectorAll('.om-appear');
        if (!targets.length) return;
        if (!('IntersectionObserver' in window)) {
          targets.forEach(function (el) {
            el.classList.add('is-shown');
          });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-shown');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
        );
        targets.forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
